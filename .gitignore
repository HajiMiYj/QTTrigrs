# ============================================================================
#  QTTrigrs  .gitignore
#
#  原则：只忽略「中间产物 / 垃圾」，不忽略运行必需的东西。
#  下面这几样是**必须提交**的，请不要加进忽略列表：
#    * lib/*.dll                        gfortran 运行时（trigrs 与 topoindex 共用）
#    * **/*.pyd                        两个 f2py 内核（trigrs_f2py / topoindex_f2py）
#    * resources/icons/*                界面图标
#    * ui/QTrigrsWindow.py              由 .ui 生成，但运行时必需
# ============================================================================

# ---------------------------------------------------------------------------
# Python 中间产物
# ---------------------------------------------------------------------------
__pycache__/
# 注意：这里**不能**写 *.py[cod] —— 那个字符类里的 d 会把 *.pyd
#（两个 f2py 内核：_trigrs_native / topoindex）一并忽略掉，而它们是运行必需的。
*.pyc
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# 虚拟环境 / 打包脚手架
# ---------------------------------------------------------------------------
.env
.venv/
venv/
env/
ENV/
__pypackages__/
.Python
*.egg-info/
.eggs/
develop-eggs/
wheels/
sdist/
parts/
.installed.cfg
MANIFEST

# ---------------------------------------------------------------------------
# IDE / 编辑器
# ---------------------------------------------------------------------------
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------------------
# Fortran 内核的编译工作区（build.py 的中间产物）
#   编译好的 .pyd 会被复制到包目录，_workspace/ 本身不用进库
# ---------------------------------------------------------------------------
_workspace/
*.build/
*.dist/
*.onefile-build/

# ---------------------------------------------------------------------------
# 打包产物
# ---------------------------------------------------------------------------
build/
dist/
main.build/
main.dist/
main.onefile-build/
*.manifest
*.spec
*.exe

# ---------------------------------------------------------------------------
# 运行 / 调试产生的日志与临时文件
# ---------------------------------------------------------------------------
*.log
TopoIndexLog.txt
TrigrsLog.txt
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------------------
# 程序跑出来的结果（列表 / 栅格产物），不要把结果提交进库
#   栅格数据一般是几十 MB 起，需要的话单独放到数据仓库
# ---------------------------------------------------------------------------
TI*.txt
TI*.asc
TI*.tif
TR*.txt
TR*.asc
TR*.tif
tpx_out/
tr_out/

# ---------------------------------------------------------------------------
# 随手写的本地验证脚本 / 临时目录
# ---------------------------------------------------------------------------
_smoke*.py
_aligncheck.py
/test.py
/tmp/
/scratch/
